// Colores y datos que comparten todas las partes de la interfaz.

// Colores. `fondo` y `acento` los elige el usuario en la configuración; el resto se
// calcula para que el texto se lea bien tanto sobre fondos oscuros como claros.
export global Tema {
    in-out property <color> fondo: #111318;
    in-out property <color> acento: #2E8B57;
    in-out property <bool> claro: false;
    in-out property <bool> acento-claro: false;
    // Opacidad del fondo: menos de 1 con transparencia (detrás se ve desenfocado).
    in-out property <float> opacidad: 1;
    // Cuántos píxeles de pantalla tiene cada píxel lógico (la escala de la ventana; la pone Rust).
    in-out property <float> escala: 1;
    out property <color> texto: claro ? #0B1230 : #FFFFFF;
    // Texto e iconos sobre el color de acento (botones, selección, interruptores).
    out property <color> sobre-acento: acento-claro ? #0B1230 : #FFFFFF;
    // Textos secundarios (títulos de sección, subtítulos, pistas). Con transparencia lo de detrás
    // puede ser de cualquier color y estos grises dejarían de leerse: cuanto más transparente es
    // el fondo, más se acercan al texto de máximo contraste.
    out property <color> texto-suave: (claro ? #4A5470 : #C3CAE6).mix(texto, opacidad);
    out property <color> texto-tenue: (claro ? #6B7390 : #8F99C7).mix(texto, opacidad);
    out property <color> capa: claro ? #0B123012 : #FFFFFF12;
    out property <color> capa-fuerte: claro ? #0B123024 : #FFFFFF24;
    out property <color> linea: claro ? #0B123024 : #FFFFFF1F;
    // Si esto es nook Pro (en la versión gratuita, sus opciones salen con la marca "Pro").
    in-out property <bool> pro;
    // Fuente de la interfaz: depende del idioma (idioma::fuente).
    in-out property <string> fuente: "Segoe UI";
}

// Botón de la tira: un grupo o una app suelta.
export struct ElementoItem {
    nombre: string,
    inicial: string,
    icono: image,
    tiene-icono: bool,
    es-app: bool,
    atajo: string,
    atajo-ok: bool,
    tiene-atajo: bool,
    // El mismo icono dibujado al tamaño que alcanza con el efecto lupa (para que no se vea borroso).
    icono-grande: image,
    // Tiene ventanas abiertas (lleva un punto debajo, como en la barra de tareas).
    abierta: bool,
    // Es de la barra y no está abierto: se puede cambiar de sitio arrastrándolo.
    fija: bool,
}

// Tarjeta de la bóveda: un grupo de textos o un texto.
export struct ItemBoveda {
    es-grupo: bool,
    titulo: string,     // nombre del grupo o lo que se ve del texto
    detalle: string,    // en los grupos, cuántos textos tienen
    etiqueta: string,   // etiqueta del texto ("" sin etiqueta)
}

// Un color de un accesorio del personaje (los que trae el programa tienen uno; los de archivos,
// uno por cada color de su dibujo): su nombre (vacío si no lo tiene), el elegido y la fila de
// colores entre los que elegir (con el del dibujo el primero, si es de un archivo), cuántos son
// fijos de la fila (los demás son propios y se pueden quitar) y cuántos van delante de ella.
export struct ColorAccesorio {
    nombre: string,
    color: color,
    paleta: [color],
    base: int,
    desplazamiento: int,
}

// Accesorio del personaje en la personalización: su id, si lo lleva puesto y sus colores.
export struct AccesorioItem {
    id: string,
    nombre: string,
    puesto: bool,
    colores: [ColorAccesorio],
}

// Combinación de colores guardada.
export struct PresetItem {
    fondo: color,
    acento: color,
}

export struct AppItem {
    nombre: string,
    inicial: string,
    icono: image,
    tiene-icono: bool,
    es-icono-grupo: bool,
}

// Opción de un menú emergente (separador: línea fina).
export struct OpcionMenu {
    id: int,
    texto: string,
    separador: bool,
}

// Fondo de la barra y de las emergentes: con transparencia, translúcido (detrás se ve
// desenfocado, ver el "cristal" de plataforma.rs), también mientras aparece y en la línea del
// modo oculto.
export component Fondo inherits Rectangle {
    background: Tema.fondo.with-alpha(Tema.opacidad);
}

// Pieza de la forma visible de la barra (la tira o el panel): dónde está en la ventana y el
// radio de cada esquina. Rust pone debajo el desenfoque (ver `recorte` en src/main.rs).
export struct Pieza {
    x: length,
    y: length,
    ancho: length,
    alto: length,
    arriba-izquierda: length,
    arriba-derecha: length,
    abajo-derecha: length,
    abajo-izquierda: length,
}

// Esquina hacia dentro donde se juntan la tira y el panel: un cuadrado al que le falta un cuarto
// de círculo. `derecha` y `abajo` dicen en qué esquina está lo lleno (la que toca las dos piezas).
export component Empalme inherits Path {
    in property <bool> derecha;
    in property <bool> abajo;
    viewbox-width: 1;
    viewbox-height: 1;
    commands: !root.derecha && !root.abajo ? "M 0 0 L 1 0 A 1 1 0 0 0 0 1 Z"
        : root.derecha && !root.abajo ? "M 1 0 L 0 0 A 1 1 0 0 1 1 1 Z"
        : !root.derecha ? "M 0 1 L 1 1 A 1 1 0 0 1 0 0 Z"
        : "M 1 1 L 0 1 A 1 1 0 0 0 1 0 Z";
}

// Botón de un addon en la tira: su icono (un trazado SVG en una caja de 24×24) y su nombre.
export struct BotonAddonItem {
    icono: string,
    nombre: string,
}

// Addon en la configuración: uno instalado o del catálogo.
export struct AddonFila {
    nombre: string,
    descripcion: string,
    icono: string,
    version: string,        // la instalada o, si no, la del catálogo
    nueva: string,          // versión del catálogo más nueva que la instalada ("" si no hay)
    instalado: bool,
    visible: bool,          // se ve en la tira
    compatible: bool,       // funciona con esta versión de nook
    ocupado: bool,          // instalándose o quitándose
    error: string,
}

// Parte de un mensaje de Claude, para mostrarlo con formato (ver src/barra/claude.rs).
export struct BloqueClaude {
    tipo: int,          // 0 párrafos y listas, 1 título, 2 cita, 3 código o tabla, 4 línea
    texto: styled-text, // con formato (los de tipo 0, 1 y 2)
    crudo: string,      // tal cual (el código)
}

// Mensaje de la conversación con Claude Code.
export struct MensajeClaude {
    tipo: int,          // 0 del usuario, 1 de Claude, 2 nota (una herramienta que usa, un error…)
    texto: string,      // tal cual, para copiarlo
    bloques: [BloqueClaude],    // los de Claude, con formato
}

// Icono del área de notificación de otro programa.
export struct IconoBandejaItem {
    icono: image,
    tiene-icono: bool,
    texto: string,      // lo que dice al pasar por encima
}
