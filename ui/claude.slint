// Conversación con Claude Code (botón de la tira, solo en Nookly Pro): arriba la carpeta en la que
// trabaja y los botones para cambiarla y empezar otra conversación; en medio la conversación, que
// se desplaza sola hasta lo último; y abajo el campo para escribirle.

import { Tema, MensajeClaude, BloqueClaude } from "tema.slint";
import { BotonTexto } from "controles.slint";

// Texto que se puede seleccionar y copiar (con Ctrl+C), pero no cambiar.
component TextoSeleccionable inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    color: Tema.texto;
    font-size: 12px;
    selection-background-color: Tema.acento;
    selection-foreground-color: Tema.sobre-acento;
}

// Parte de un mensaje de Claude con su formato.
component Bloque inherits VerticalLayout {
    in property <BloqueClaude> bloque;
    callback abrir-enlace(string);

    if root.bloque.tipo <= 1 : StyledText {
        text: root.bloque.texto;
        default-color: Tema.texto;
        default-font-size: root.bloque.tipo == 1 ? 14px : 12px;
        link-color: Tema.acento;
        link-clicked(enlace) => { root.abrir-enlace(enlace); }
    }
    if root.bloque.tipo == 2 : HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: Tema.linea;
        }
        StyledText {
            horizontal-stretch: 1;
            text: root.bloque.texto;
            default-color: Tema.texto-suave;
            default-font-size: 12px;
            link-color: Tema.acento;
            link-clicked(enlace) => { root.abrir-enlace(enlace); }
        }
    }
    if root.bloque.tipo == 3 : Rectangle {
        background: Tema.capa;
        border-radius: 8px;
        VerticalLayout {
            padding: 8px;
            TextoSeleccionable {
                text: root.bloque.crudo;
                font-family: "Consolas";
                font-size: 11px;
            }
        }
    }
    if root.bloque.tipo == 4 : Rectangle {
        height: 1px;
        background: Tema.linea;
    }
}

// Cuánto se ha usado de un límite: un anillo que se llena (del color de acento, en rojo al pasar
// del 90 %) con el porcentaje dentro, y a su lado su nombre y cuándo se reinicia.
component AnilloUso inherits HorizontalLayout {
    in property <string> nombre;
    in property <float> parte: -1;      // 0–1 usado; -1 si aún no se sabe
    in property <string> reinicio;      // "hasta 14:20"
    spacing: 6px;

    Rectangle {
        width: 30px;
        height: 30px;
        Path {
            width: 30px;
            height: 30px;
            viewbox-width: 30;
            viewbox-height: 30;
            commands: "M 15 3 A 12 12 0 1 1 14.99 3";
            stroke: Tema.capa-fuerte;
            stroke-width: 3.5px;
            fill: transparent;
        }
        if root.parte > 0 : Path {
            property <angle> giro: min(root.parte, 0.999) * 360deg;
            width: 30px;
            height: 30px;
            viewbox-width: 30;
            viewbox-height: 30;
            commands: "M 15 3 A 12 12 0 " + (root.parte > 0.5 ? "1" : "0") + " 1 "
                + (15 + 12 * sin(self.giro)) + " " + (15 - 12 * cos(self.giro));
            stroke: root.parte >= 0.9 ? #E5484D : Tema.acento;
            stroke-width: 3.5px;
            fill: transparent;
        }
        Text {
            text: root.parte < 0 ? "—" : round(root.parte * 100) + "%";
            color: Tema.texto;
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        alignment: center;
        Text {
            text: root.nombre;
            color: Tema.texto;
            font-size: 10px;
            font-weight: 600;
        }
        if root.reinicio != "" : Text {
            text: root.reinicio;
            color: Tema.texto-tenue;
            font-size: 9px;
        }
    }
}

// Botón para elegir una opción (el modelo o el esfuerzo): abre un menú.
component Selector inherits Rectangle {
    in property <string> texto;
    callback clicked();
    width: etiqueta.preferred-width + 30px;
    height: 24px;
    border-radius: 9px;
    background: area.has-hover ? Tema.capa-fuerte : Tema.capa;
    etiqueta := Text {
        x: 10px;
        text: root.texto;
        color: Tema.texto;
        font-size: 11px;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 16px;
        text: "▾";
        color: Tema.texto-tenue;
        font-size: 10px;
        vertical-alignment: center;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botón pequeño de texto, bajo los mensajes de Claude.
component Accion inherits Text {
    callback clicked();
    color: area.has-hover ? Tema.texto : Tema.texto-tenue;
    font-size: 11px;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Un mensaje: los del usuario en un globo, los de Claude con formato (o, para seleccionar una
// parte, tal cual) y las notas en pequeño.
component Mensaje inherits Rectangle {
    in property <MensajeClaude> mensaje;
    callback copiar(string);
    callback abrir-enlace(string);
    property <bool> seleccionando;
    background: root.mensaje.tipo == 0 ? Tema.capa : transparent;
    border-radius: 10px;

    VerticalLayout {
        padding-left: root.mensaje.tipo == 0 ? 10px : 2px;
        padding-right: self.padding-left;
        padding-top: root.mensaje.tipo == 0 ? 7px : 0px;
        padding-bottom: self.padding-top;
        spacing: 6px;
        if root.mensaje.tipo == 0 || (root.mensaje.tipo == 1 && root.seleccionando) : TextoSeleccionable {
            text: root.mensaje.texto;
        }
        if root.mensaje.tipo == 1 && !root.seleccionando : VerticalLayout {
            spacing: 8px;
            for bloque in root.mensaje.bloques : Bloque {
                bloque: bloque;
                abrir-enlace(enlace) => { root.abrir-enlace(enlace); }
            }
        }
        if root.mensaje.tipo == 2 : Text {
            text: root.mensaje.texto;
            color: Tema.texto-tenue;
            font-size: 11px;
            font-italic: true;
            wrap: word-wrap;
        }
        if root.mensaje.tipo == 1 : HorizontalLayout {
            alignment: end;
            spacing: 12px;
            Accion {
                text: @tr("Copiar");
                clicked => { root.copiar(root.mensaje.texto); }
            }
            Accion {
                text: root.seleccionando ? @tr("Ver con formato") : @tr("Seleccionar texto");
                clicked => { root.seleccionando = !root.seleccionando; }
            }
        }
    }
}

// Campo para escribirle: crece con el texto (hasta unas 7 líneas; luego se desplaza). Intro lo
// envía y Mayús+Intro pasa a la línea siguiente.
component CampoMensaje inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted();

    public function enfocar() {
        entrada.focus();
    }

    property <length> margen: 7px;
    height: clamp(entrada.preferred-height + 2 * self.margen, 30px, 120px);
    border-radius: 11px;
    background: Tema.capa;
    border-width: 1px;
    border-color: entrada.has-focus ? Tema.acento : Tema.linea;

    Text {
        visible: root.text == "";
        x: 10px;
        y: root.margen;
        text: root.placeholder;
        color: Tema.texto-tenue;
        font-size: 12px;
    }

    Rectangle {
        x: 10px;
        y: root.margen;
        width: parent.width - 20px;
        height: parent.height - 2 * root.margen;
        clip: true;

        FocusScope {
            capture-key-pressed(evento) => {
                if (evento.text == Key.Return && !evento.modifiers.shift) {
                    root.accepted();
                    return accept;
                }
                return reject;
            }
            entrada := TextInput {
                // Cuánto se ha subido el texto para seguir al cursor.
                property <length> corrido;
                y: min(0px, max(parent.height - self.height, self.corrido));
                width: parent.width;
                height: max(parent.height, self.preferred-height);
                text <=> root.text;
                color: Tema.texto;
                font-size: 12px;
                single-line: false;
                wrap: word-wrap;
                selection-background-color: Tema.acento;
                selection-foreground-color: Tema.sobre-acento;
                cursor-position-changed(cursor) => {
                    if (cursor.y + self.corrido < 0px) {
                        self.corrido = -cursor.y;
                    } else if (cursor.y + 16px + self.corrido > parent.height) {
                        self.corrido = parent.height - cursor.y - 16px;
                    }
                }
            }
        }
    }
}

export component PanelClaude inherits Rectangle {
    in property <[MensajeClaude]> mensajes;
    in property <bool> ocupado;             // Claude está respondiendo
    in property <string> carpeta;
    in property <string> modelo;            // "Modelo: Opus"
    in property <string> esfuerzo;          // "Esfuerzo: Alto"
    // Parte usada de los límites de 5 horas y semanal (-1 si aún no se sabe) y cuándo se reinician.
    in property <float> uso-cinco-horas: -1;
    in property <string> reinicio-cinco-horas;
    in property <float> uso-semana: -1;
    in property <string> reinicio-semana;
    in-out property <string> texto;         // lo que se está escribiendo
    callback enviar(string);
    callback elegir-modelo();
    callback elegir-esfuerzo();
    callback parar();
    callback nueva-conversacion();
    callback elegir-carpeta();
    callback copiar(string);
    callback abrir-enlace(string);

    public function enfocar() {
        campo.enfocar();
    }

    function enviar-texto() {
        if (!root.ocupado && root.texto != "") {
            root.enviar(root.texto);
            root.texto = "";
        }
    }

    HorizontalLayout {
        x: 16px;
        y: 12px;
        width: parent.width - 32px;
        height: 30px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "Claude Code";
                color: Tema.texto;
                font-size: 12px;
                font-weight: 700;
            }
            Text {
                text: root.carpeta;
                color: Tema.texto-tenue;
                font-size: 10px;
                overflow: elide;
            }
        }
        BotonTexto {
            texto: @tr("Carpeta…");
            clicked => { root.elegir-carpeta(); }
        }
        BotonTexto {
            texto: @tr("Nueva");
            clicked => { root.nueva-conversacion(); }
        }
    }

    // Modelo, esfuerzo y cuánto se ha usado de los límites.
    HorizontalLayout {
        x: 16px;
        y: 50px;
        width: parent.width - 32px;
        height: 32px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Selector {
                texto: root.modelo;
                clicked => { root.elegir-modelo(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Selector {
                texto: root.esfuerzo;
                clicked => { root.elegir-esfuerzo(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        AnilloUso {
            nombre: @tr("5 horas");
            parte: root.uso-cinco-horas;
            reinicio: root.reinicio-cinco-horas;
        }
        AnilloUso {
            nombre: @tr("Semana");
            parte: root.uso-semana;
            reinicio: root.reinicio-semana;
        }
    }

    lista := Flickable {
        x: 16px;
        y: 92px;
        width: parent.width - 32px;
        height: parent.height - 92px - 12px - abajo.height - 12px;
        content-height: max(self.height, contenido.preferred-height);
        // Al llegar algo nuevo, se baja hasta el final.
        changed content-height => { self.content-y = min(0px, self.height - self.content-height); }

        contenido := VerticalLayout {
            width: lista.width;
            spacing: 10px;
            alignment: start;
            for mensaje in root.mensajes : Mensaje {
                mensaje: mensaje;
                copiar(texto) => { root.copiar(texto); }
                abrir-enlace(enlace) => { root.abrir-enlace(enlace); }
            }
            if root.ocupado : Text {
                text: @tr("Claude está trabajando…");
                color: Tema.texto-tenue;
                font-size: 11px;
                font-italic: true;
            }
        }
    }

    abajo := HorizontalLayout {
        x: 16px;
        y: parent.height - 12px - self.height;
        width: parent.width - 32px;
        height: campo.height;
        spacing: 8px;
        alignment: stretch;
        campo := CampoMensaje {
            horizontal-stretch: 1;
            text <=> root.texto;
            placeholder: @tr("Escribe a Claude…");
            accepted => { root.enviar-texto(); }
        }
        VerticalLayout {
            alignment: end;
            if !root.ocupado : BotonTexto {
                texto: @tr("Enviar");
                peligro: true;
                clicked => { root.enviar-texto(); }
            }
            if root.ocupado : BotonTexto {
                texto: @tr("Parar");
                clicked => { root.parar(); }
            }
        }
    }
}
